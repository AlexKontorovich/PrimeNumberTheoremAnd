/-- The exact prime-product inequality at every prime below the analytic handoff. -/
theorem finite_prime_product {x : ℕ} (hx : x.Prime) (h5 : 5 ≤ x) (h557 : x ≤ 557) :
    primeProduct x <
      Real.exp eulerMascheroniConstant * Real.log (primeTheta x) +
        2.50637 / Real.log (primeTheta x) := by
  exact inv_557.2.2.2.2.2.2.2.2 x h5 h557 hx

/-- There are no overlooked prime cutoffs between the finite certificate
and the analytic threshold. The primality decisions are checked by the kernel. -/
theorem prime_lt_563_le_557 {x : ℕ} (hx : x.Prime) (h563 : x < 563) : x ≤ 557 := by
  by_contra h
  have hcheck : ∀ n ∈ Finset.Icc 558 562, ¬Nat.Prime n := by decide +kernel
  exact hcheck x (by simp only [Finset.mem_Icc]; omega) hx

private theorem log_ge_six {x : ℕ} (hx : 563 ≤ x) : 6 ≤ Real.log (x : ℝ) := by
  have hx0 : (0 : ℝ) < x := by exact_mod_cast (show 0 < x by omega)
  rw [Real.le_log_iff_exp_le hx0]
  calc
    Real.exp 6 = Real.exp 1 ^ 6 := by rw [← Real.exp_nat_mul]; norm_num
    _ ≤ (2.7182818286 : ℝ) ^ 6 :=
      pow_le_pow_left₀ (Real.exp_pos 1).le Real.exp_one_lt_d9.le 6
    _ ≤ 563 := by norm_num
    _ ≤ (x : ℝ) := by exact_mod_cast hx

/-- Global prime-product comparison from the two analytic RS62 inputs.
The finite range is proved above rather than supplied as a hypothesis. -/
theorem prime_product_of_rs62_inputs
    (hθ : ∀ x : ℕ, 563 ≤ x →
      (x : ℝ) * (1 - 1 / (2 * Real.log x)) ≤ primeTheta x)
    (hP : ∀ x : ℕ, 563 ≤ x →
      primeProduct x < Real.exp eulerMascheroniConstant *
        (Real.log x + 1 / (2 * Real.log x)))
    {x : ℕ} (hx : x.Prime) (h5 : 5 ≤ x) :
    primeProduct x <
      Real.exp eulerMascheroniConstant * Real.log (primeTheta x) +
        2.50637 / Real.log (primeTheta x) := by
  rcases lt_or_ge x 563 with hsmall | hlarge
  · exact finite_prime_product hx h5 (prime_lt_563_le_557 hx hsmall)
  · exact rs62_primeProduct_bound_of_inputs
      (by linarith [Totient.exp_gamma_ge]) SmallTotientProduct.exp_gamma_le
      (by exact_mod_cast (show 0 < x by omega)) (log_ge_six hlarge)
      (hθ x hlarge) (hP x hlarge)

/-- The unrestricted RS62 totient inequality, conditional only on the two
explicit analytic inputs at the prime-cutoff level. No upper bound on n is used. -/
theorem totient_ratio_lt_of_rs62_inputs
    (hθ : ∀ x : ℕ, 563 ≤ x →
      (x : ℝ) * (1 - 1 / (2 * Real.log x)) ≤ primeTheta x)
    (hP : ∀ x : ℕ, 563 ≤ x →
      primeProduct x < Real.exp eulerMascheroniConstant *
        (Real.log x + 1 / (2 * Real.log x)))
    {n : ℕ} (hn : 3 ≤ n) :
    (n : ℝ) / Nat.totient n <
      Real.exp eulerMascheroniConstant * Real.log (Real.log (n : ℝ)) +
        2.50637 / Real.log (Real.log (n : ℝ)) := by
  apply Totient.totient_ratio_lt_of_prime_product_at_rank
    (by omega) (by exact_mod_cast hn) le_rfl
  intro hcard
  apply prime_product_of_rs62_inputs hθ hP (Nat.prime_nth_prime _)
  rw [← Nat.nth_prime_two_eq_five]
  exact Nat.nth_monotone Nat.infinite_setOfPred_prime (by omega)


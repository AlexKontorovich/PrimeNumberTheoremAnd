'TernaryGoldbach.RSBounds.Totient.totient_ratio_lt_of_card_le_twenty' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'TernaryGoldbach.RSBounds.Totient.totient_ratio_lt_of_le_1e27' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]

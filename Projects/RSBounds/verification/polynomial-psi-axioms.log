'TernaryGoldbach.RSBounds.PolynomialPsi.fourthDifference_Psi4_lower' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'TernaryGoldbach.RSBounds.PolynomialPsi.psi_error_of_polynomial_errors' depends on axioms: [propext,
 Classical.choice,

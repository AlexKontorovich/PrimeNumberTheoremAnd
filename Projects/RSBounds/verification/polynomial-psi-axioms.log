'TernaryGoldbach.RSBounds.PolynomialPsi.psi_sandwich' depends on axioms: [propext, Classical.choice, Quot.sound]
'TernaryGoldbach.RSBounds.PolynomialPsi.fourthDifference_psi4Trunc' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'TernaryGoldbach.RSBounds.PolynomialPsi.fourthDifference_Psi4' depends on axioms: [propext,
 Classical.choice,

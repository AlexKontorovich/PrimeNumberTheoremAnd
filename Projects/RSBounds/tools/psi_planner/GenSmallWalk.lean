import RSBounds.PsiFinite.SmallWalk
/-! Writes RSBounds/PsiFinite/SmallWalkData.lean (untrusted generator).
Run from Projects/RSBounds: `lake env lean --run tools/psi_planner/GenSmallWalk.lean` -/
open PsiFinite
def showWS (s : WS) : String := s!"⟨{s.Llo}, {s.Lhi}, {s.Plo}, {s.Phi}⟩"
def main : IO Unit := do
  let chunks : List (Nat × Nat) := [(1, 999)] ++ (List.range 9).map (fun i => (1000 * (i + 1), 1000))
  let mut s : WS := ⟨0, 0, 0, 0⟩
  let mut out := "import RSBounds.PsiFinite.SmallWalk\n\n/-!\n# Data of the small walk (generated by `tools/psi_planner/GenSmallWalk.lean`)\n\nEach theorem is checked by the kernel.\n-/\n\nnamespace PsiFinite.SmallWalkData\n\nopen PsiFinite\n\n"
  let mut i := 0
  for (n, len) in chunks do
    match walkG len n s with
    | none => throw (IO.userError s!"walk fails in chunk starting at {n}")
    | some s' =>
      out := out ++ s!"theorem wk_{i} : walkK {len} {n} {showWS s} = some {showWS s'} := by\n  decide +kernel\n\n"
      s := s'
      i := i + 1
  out := out ++ "end PsiFinite.SmallWalkData\n"
  IO.FS.writeFile "RSBounds/PsiFinite/SmallWalkData.lean" out
  IO.println s!"final state at 10000: {showWS s}"

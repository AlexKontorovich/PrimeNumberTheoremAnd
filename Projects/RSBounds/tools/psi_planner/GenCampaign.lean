import RSBounds.PsiFinite.Gen
import Std.Data.HashMap

/-!
# Campaign generator (untrusted)

    lake env lean --run tools/psi_planner/GenCampaign.lean <name> <loStart> <Aend> \
        <log2 segment bits> <segments per module> <plo> <phi> <llo> <lhi> [plan file]

starts from the enclosures `⟨plo, phi, llo, lhi⟩` of `ψ` and `log` at
`loStart - 1`, and covers `(loStart - 1, Aend]` with segments of `2^s` bits
(the last one shorter). For each segment it takes the block exponent `w` from
the plan file (lines `lo w`, from `psi_planner.c`) when given, else from the
previous segment plus one, and lowers it until the exact compiled twin
`runSegG` accepts the segment. It writes

* `RSBounds/PsiFinite/Campaign/<name>/M<j>.lean`: Mathlib-free modules of
  theorems `checkSegK 4 5 lo w B s = some s'`, each proved by `decide +kernel`;
* `RSBounds/PsiFinite/Campaign/<name>/Chain.lean`: the list of all segments
  with their states, for the assembly generator;
* `RSBounds/PsiFinite/Campaign/<name>/Assembly.lean`, chaining them with
  `PsiFinite.seg_chain`.

Everything it outputs is rechecked by the kernel.
-/

open PsiFinite PsiFinite.Gen

def showSt (s : St) : String := s!"⟨{s.plo}, {s.phi}, {s.llo}, {s.lhi}⟩"

deriving instance Inhabited for PsiFinite.St

structure Seg where
  lo : Nat
  w : Nat
  B : Nat
  s : St
  s' : St
deriving Inhabited

/-- The largest `w ≤ wmax` with `2^w ∣ bits`. -/
def fitW (bits wmax : Nat) : Nat := Id.run do
  let mut w := wmax
  while w > 0 && bits % (1 <<< w) != 0 do w := w - 1
  return w

def readPlan (path : String) : IO (Std.HashMap Nat Nat) := do
  let mut m : Std.HashMap Nat Nat := {}
  for line in (← IO.FS.lines path) do
    match line.splitOn " " with
    | [a, b] => m := m.insert a.toNat! b.toNat!
    | _ => pure ()
  return m

def main (args : List String) : IO UInt32 := do
  let name := args[0]!
  let loStart := args[1]!.toNat!
  let Aend := args[2]!.toNat!
  let sbits := args[3]!.toNat!
  let perMod := args[4]!.toNat!
  let s0 : St := ⟨args[5]!.toNat!, args[6]!.toNat!, args[7]!.toNat!, args[8]!.toNat!⟩
  let plan ← match args[9]? with
    | some p => readPlan p
    | none => pure {}
  let mut segs : Array Seg := #[]
  let mut lo := loStart
  let mut s := s0
  let mut wprev := 4
  let mut retries := 0
  while lo - 1 < Aend do
    let remaining := (Aend - (lo - 1)) / 2
    let bits := min (1 <<< sbits) remaining
    let wmax := fitW bits (match plan.get? lo with | some w => w | none => wprev + 1)
    let mut w := wmax
    let mut found : Option St := none
    while found.isNone do
      if bits % (1 <<< w) != 0 then w := w - 1; continue
      found := runSegG 4 5 lo w (bits / (1 <<< w)) s
      if found.isNone then
        if w == 0 then
          IO.eprintln s!"segment at lo={lo} fails even with w=0"; return 1
        w := w - 1
        retries := retries + 1
    let s' := found.get!
    segs := segs.push ⟨lo, w, bits / (1 <<< w), s, s'⟩
    lo := lo + 2 * bits
    s := s'
    wprev := w
  let dir := s!"RSBounds/PsiFinite/Campaign/{name}"
  IO.FS.createDirAll dir
  let nmod := (segs.size + perMod - 1) / perMod
  for j in [0:nmod] do
    let mut out := s!"import RSBounds.PsiFinite.Kernel\n\n/-! Generated by `tools/psi_planner/GenCampaign.lean`; " ++
      s!"each theorem is checked by the kernel. No Mathlib. -/\n\nnamespace PsiFinite.Campaign.{name}\n\n"
    for i in [j * perMod : min segs.size ((j + 1) * perMod)] do
      let g := segs[i]!
      out := out ++ s!"theorem seg{i} : {stmt 4 5 g.lo g.w g.B g.s g.s'} := by\n  decide +kernel\n\n"
    out := out ++ s!"end PsiFinite.Campaign.{name}\n"
    IO.FS.writeFile s!"{dir}/M{j}.lean" out
  -- assembly
  let mut asm := s!"import RSBounds.PsiFinite.Segment\nimport RSBounds.PsiFinite.BaseCert\n"
  for j in [0:nmod] do asm := asm ++ s!"import RSBounds.PsiFinite.Campaign.{name}.M{j}\n"
  let g0 := segs[0]!
  let gl := segs[segs.size - 1]!
  let Aendv := gl.lo - 1 + 2 * (1 <<< gl.w) * gl.B
  asm := asm ++ s!"\n/-! Generated by `tools/psi_planner/GenCampaign.lean`. -/\n\nnamespace PsiFinite.Campaign.{name}\n\nopen PsiFinite\n\n"
  asm := asm ++ s!"theorem chain (h : Encl {g0.lo - 1} {showSt g0.s}) :\n    Encl {Aendv} {showSt gl.s'} ∧ BoundOn 4 5 {g0.lo - 1} {Aendv} := by\n"
  for i in [0:segs.size] do
    let g := segs[i]!
    let a := g.lo - 1
    let b := a + 2 * (1 <<< g.w) * g.B
    let prev := if i == 0 then "h" else s!"h{i - 1}.1"
    asm := asm ++ s!"  have h{i} := seg_chain baseFacts seg{i} (A := {a}) (A' := {b}) rfl rfl (by decide) {prev}\n"
    if i > 0 then
      asm := asm ++ s!"  have b{i} := BoundOn.trans b{i - 1} h{i}.2\n"
    else
      asm := asm ++ s!"  have b0 := h0.2\n"
  asm := asm ++ s!"  exact ⟨h{segs.size - 1}.1, b{segs.size - 1}⟩\n\nend PsiFinite.Campaign.{name}\n"
  IO.FS.writeFile s!"{dir}/Assembly.lean" asm
  IO.println s!"{segs.size} segments in {nmod} modules, {retries} retries; end state at {Aendv}: {showSt gl.s'}"
  return 0

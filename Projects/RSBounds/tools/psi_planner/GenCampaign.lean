import RSBounds.PsiFinite.Gen
import Std.Data.HashMap

/-!
# Campaign generator (untrusted)

    lake exe psi_gen <name> <loStart> <Aend> <log2 segment bits> <segments per module>
        <plo> <phi> <llo> <lhi> [plan file | -] [log2 early bits] [early end] [segments per group]

starts from the enclosures `⟨plo, phi, llo, lhi⟩` of `ψ` and `log` at
`loStart - 1`, and covers `(loStart - 1, Aend]` with segments of `2^s` bits
(`2^early` bits below `early end`; the last one shorter). For each segment it takes the block exponent `w` from
the plan file (lines `lo w`, from `psi_planner.c`) when given, else from the
previous segment plus one, and lowers it until the exact compiled twin
`runSegG` accepts the segment. It writes

* `RSBounds/PsiFinite/Campaign/<name>/M<j>.lean`: Mathlib-free modules of
  theorems `checkSegK 4 5 lo w B s = some s'`, each proved by `decide +kernel`;
* `RSBounds/PsiFinite/Campaign/<name>/Asm/G<g>.lean`: Mathlib modules chaining
  groups of segments with `PsiFinite.seg_chain`;
* `RSBounds/PsiFinite/Campaign/<name>/Assembly.lean`: the chain of the groups;
* `RSBounds/PsiFinite/Campaign/<name>/segments.txt`: the segments used.

Everything it outputs is rechecked by the kernel.
-/

open PsiFinite PsiFinite.Gen

def showSt (s : St) : String := s!"⟨{s.plo}, {s.phi}, {s.llo}, {s.lhi}⟩"

deriving instance Inhabited for PsiFinite.St

structure Seg where
  lo : Nat
  w : Nat
  B : Nat
  s : St
  s' : St
deriving Inhabited

/-- The largest `w ≤ wmax` with `2^w ∣ bits`. -/
def fitW (bits wmax : Nat) : Nat := Id.run do
  let mut w := wmax
  while w > 0 && bits % (1 <<< w) != 0 do w := w - 1
  return w

def readPlan (path : String) : IO (Std.HashMap Nat Nat) := do
  let mut m : Std.HashMap Nat Nat := {}
  for line in (← IO.FS.lines path) do
    match line.splitOn " " with
    | [a, b] => m := m.insert a.toNat! b.toNat!
    | _ => pure ()
  return m

def main (args : List String) : IO UInt32 := do
  let name := args[0]!
  let loStart := args[1]!.toNat!
  let Aend := args[2]!.toNat!
  let sbits := args[3]!.toNat!
  let perMod := args[4]!.toNat!
  let s0 : St := ⟨args[5]!.toNat!, args[6]!.toNat!, args[7]!.toNat!, args[8]!.toNat!⟩
  let plan ← match args[9]? with
    | some p => if p == "-" then pure {} else readPlan p
    | none => pure {}
  let sEarly := (args[10]?.map String.toNat!).getD sbits
  let Xs := (args[11]?.map String.toNat!).getD 0
  let perGroup := (args[12]?.map String.toNat!).getD 1000
  let mut segs : Array Seg := #[]
  let mut lo := loStart
  let mut s := s0
  let mut wprev := 4
  let mut retries := 0
  while lo - 1 < Aend do
    let remaining := (Aend - (lo - 1)) / 2
    let bits := min (1 <<< (if lo < Xs then sEarly else sbits)) remaining
    let wmax := fitW bits (match plan.get? lo with | some w => w | none => wprev + 1)
    let mut w := wmax
    let mut found : Option St := none
    while found.isNone do
      if bits % (1 <<< w) != 0 then w := w - 1; continue
      found := runSegG 4 5 lo w (bits / (1 <<< w)) s
      if found.isNone then
        if w == 0 then
          IO.eprintln s!"segment at lo={lo} fails even with w=0"; return 1
        w := w - 1
        retries := retries + 1
    let s' := found.get!
    segs := segs.push ⟨lo, w, bits / (1 <<< w), s, s'⟩
    lo := lo + 2 * bits
    s := s'
    wprev := w
  let dir := s!"RSBounds/PsiFinite/Campaign/{name}"
  IO.FS.createDirAll dir
  let nmod := (segs.size + perMod - 1) / perMod
  for j in [0:nmod] do
    let mut out := s!"import RSBounds.PsiFinite.Kernel\n\n/-! Generated by `tools/psi_planner/GenCampaign.lean`; " ++
      s!"each theorem is checked by the kernel. No Mathlib. -/\n\n" ++
      "-- Sequential elaboration frees each theorem's kernel memory before the next one.\n" ++
      s!"set_option Elab.async false\n\nnamespace PsiFinite.Campaign.{name}\n\n"
    for i in [j * perMod : min segs.size ((j + 1) * perMod)] do
      let g := segs[i]!
      out := out ++ s!"theorem seg{i} : {stmt 4 5 g.lo g.w g.B g.s g.s'} := by\n  decide +kernel\n\n"
    out := out ++ s!"end PsiFinite.Campaign.{name}\n"
    IO.FS.writeFile s!"{dir}/M{j}.lean" out
  -- assembly: groups of `perGroup` segments, then the chain of groups
  let ngrp := (segs.size + perGroup - 1) / perGroup
  IO.FS.createDirAll s!"{dir}/Asm"
  let endOf (g : Seg) : Nat := g.lo - 1 + 2 * (1 <<< g.w) * g.B
  for gi in [0:ngrp] do
    let i0 := gi * perGroup
    let i1 := min segs.size ((gi + 1) * perGroup)
    let mut asm := "import RSBounds.PsiFinite.Chain\nimport RSBounds.PsiFinite.BaseCert\n"
    for j in [i0 / perMod : (i1 + perMod - 1) / perMod] do
      asm := asm ++ s!"import RSBounds.PsiFinite.Campaign.{name}.M{j}\n"
    asm := asm ++ s!"\n/-! Generated by `tools/psi_planner/GenCampaign.lean`. -/\n\n" ++
      s!"namespace PsiFinite.Campaign.{name}\n\nopen PsiFinite\n\n"
    let stp (g : Seg) : String := s!"Step {g.lo - 1} {showSt g.s} {endOf g} {showSt g.s'}"
    for i in [i0:i1] do
      let g := segs[i]!
      asm := asm ++ s!"theorem st{i} : {stp g} :=\n  step_of_seg baseFacts seg{i} rfl rfl (by decide)\n\n"
    -- chunks of 40 steps, then the group
    let mut chunks : Array (Nat × Nat) := #[]
    let mut c0 := i0
    while c0 < i1 do
      let c1 := min i1 (c0 + 40)
      chunks := chunks.push (c0, c1)
      c0 := c1
    let comb (names : Array String) : String := Id.run do
      let mut t := names[names.size - 1]!
      for k in [0:names.size - 1] do
        t := s!"({names[names.size - 2 - k]!}.comp {t})"
      return t
    for (a, b) in chunks do
      let ga := segs[a]!
      let gb := segs[b - 1]!
      let names := (List.range (b - a)).toArray.map (fun k => s!"st{a + k}")
      asm := asm ++ s!"theorem ch{a} : Step {ga.lo - 1} {showSt ga.s} {endOf gb} {showSt gb.s'} :=\n  {comb names}\n\n"
    let g0 := segs[i0]!
    let gl := segs[i1 - 1]!
    asm := asm ++ s!"theorem grp{gi} : Step {g0.lo - 1} {showSt g0.s} {endOf gl} {showSt gl.s'} :=\n  " ++
      comb (chunks.map (fun (a, _) => s!"ch{a}")) ++ "\n\n"
    asm := asm ++ s!"end PsiFinite.Campaign.{name}\n"
    IO.FS.writeFile s!"{dir}/Asm/G{gi}.lean" asm
  let g0 := segs[0]!
  let gl := segs[segs.size - 1]!
  let mut fin := "import RSBounds.PsiFinite.Chain\n"
  for gi in [0:ngrp] do fin := fin ++ s!"import RSBounds.PsiFinite.Campaign.{name}.Asm.G{gi}\n"
  fin := fin ++ s!"\n/-! Generated by `tools/psi_planner/GenCampaign.lean`. -/\n\nnamespace PsiFinite.Campaign.{name}\n\nopen PsiFinite\n\n"
  let mut t := s!"grp{ngrp - 1}"
  for k in [0:ngrp - 1] do t := s!"(grp{ngrp - 2 - k}.comp {t})"
  fin := fin ++ s!"theorem chain : Step {g0.lo - 1} {showSt g0.s} {endOf gl} {showSt gl.s'} :=\n  {t}\n\nend PsiFinite.Campaign.{name}\n"
  IO.FS.writeFile s!"{dir}/Assembly.lean" fin
  -- plan actually used
  let mut used := ""
  for g in segs do used := used ++ s!"{g.lo} {g.w} {g.B}\n"
  IO.FS.writeFile s!"{dir}/segments.txt" used
  IO.println s!"{segs.size} segments in {nmod} modules, {retries} retries; end state at {endOf gl}: {showSt gl.s'}"
  return 0

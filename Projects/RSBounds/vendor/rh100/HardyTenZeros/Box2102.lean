/-- `ζ` has a zero `1/2 + it` with `21.02 < t < 21.03`. No minimality and no
uniqueness is asserted. -/
theorem zero_in_2102 :
    ∃ t ∈ Set.Ioo (2102 / 100 : ℝ) (2103 / 100), riemannZeta (1 / 2 + t * I) = 0 := by
  have h := zero_of_tables (a := 2102 / 100) (b := 2103 / 100)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (Na := 27) (Nb := 20) (by norm_num) (by norm_num)
    I2102.tA_mem I2102.tB_mem
    (ra := (5099019 / 1000000 : ℚ)) (Ra := (199868897 / 1000 : ℚ)) (ea := (442494631 / 500000000000 : ℚ))
    (rb := (2179449 / 500000 : ℚ)) (Rb := (200245077 / 1000 : ℚ)) (eb := (83056537 / 31250000000 : ℚ))
    (by norm_num) (by norm_num) (by norm_num) (by norm_num [q4Q]) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num [q4Q]) (by norm_num)
    I2102.product_hi_neg
  have e1 : ((2102 / 100 : ℚ) : ℝ) = 2102 / 100 := by norm_num
  have e2 : ((2103 / 100 : ℚ) : ℝ) = 2103 / 100 := by norm_num
  rw [e1, e2] at h
  exact h


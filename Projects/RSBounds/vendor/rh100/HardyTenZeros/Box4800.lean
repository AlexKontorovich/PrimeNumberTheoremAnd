/-- `ζ` has a zero `1/2 + it` with `48.00 < t < 48.01`. No minimality and no
uniqueness is asserted. -/
theorem zero_in_4800 :
    ∃ t ∈ Set.Ioo (4800 / 100 : ℝ) (4801 / 100), riemannZeta (1 / 2 + t * I) = 0 := by
  have h := zero_of_tables (a := 4800 / 100) (b := 4801 / 100)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (Na := 45) (Nb := 47) (by norm_num) (by norm_num)
    I4800.tA_mem I4800.tB_mem
    (ra := (6633249 / 1000000 : ℚ)) (Ra := (5332614577 / 1000 : ℚ)) (ea := (58516097 / 15625000000 : ℚ))
    (rb := (6782329 / 1000000 : ℚ)) (Rb := (133426243 / 25 : ℚ)) (eb := (3208103419 / 1000000000000 : ℚ))
    (by norm_num) (by norm_num) (by norm_num) (by norm_num [q4Q]) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num [q4Q]) (by norm_num)

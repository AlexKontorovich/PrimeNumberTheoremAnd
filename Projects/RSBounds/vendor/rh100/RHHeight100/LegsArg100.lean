/-- The box `M_68(1/2 + 100 i)` inflated by the order-4 remainder radius. -/
def box : ComplexInterval :=
  (mainBoxG tab 68 (1 / 2 : ℚ) (100 : ℚ)).inflate (remR tab 68 (1 / 2 : ℚ) (1001050065657 / 10000 : ℚ))

theorem box_contains :
    box.contains (riemannZeta (ptQ (1 / 2 : ℚ) (100 : ℚ))) :=
  zeta_mem_pointBox (a := (1 / 2 : ℚ)) (y := (100 : ℚ)) (by norm_num) (by norm_num) (N := 68)
    (by norm_num) tab_mem (P := (1001050065657 / 10000 : ℚ)) (by norm_num) (by decide +kernel) le_rfl

/-- The box lies in the open right half-plane, below the real axis, and `Im lo / Re lo ≥ -1/5` (it is -0.014228, rounded here). -/
theorem box_ok :
    0 < box.re.lo ∧ box.im.hi ≤ 0 ∧ (-1 / 5 : ℚ) ≤ box.im.lo / box.re.lo := by
  decide +kernel

/-- `-1/5 ≤ arg ζ(1/2 + 100 i) ≤ 0`. -/
theorem arg_bounds :
    ((-1 / 5 : ℚ) : ℝ) ≤ (riemannZeta (ptQ (1 / 2 : ℚ) (100 : ℚ))).arg ∧
      (riemannZeta (ptQ (1 / 2 : ℚ) (100 : ℚ))).arg ≤ 0 := by
  obtain ⟨h1, h2, h3⟩ := box_ok
  obtain ⟨h4, h5⟩ := arg_mem_of_box box_contains h1 h2
  refine ⟨le_trans ?_ h4, h5⟩
  exact_mod_cast h3

end RHHeight.Legs.Arg100
